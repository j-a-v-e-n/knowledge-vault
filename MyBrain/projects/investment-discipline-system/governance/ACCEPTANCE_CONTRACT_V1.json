{
  "schema_version": 1,
  "contract_id": "ids-local-paper-workbench-v1",
  "status": "candidate_under_challenge",
  "release_target": "个人、本地优先、纸面交易的投研纪律工作台 V1",
  "objective": "让 Javen 能够在本地完成假设预注册、证据记录、AI 候选建议、人工最终决定、确定性风险检查、本地纸面执行、三轨复盘和可恢复审计；任何完成声明都由冻结要求与独立证据约束。",
  "scope": [
    "单用户、单机、loopback 本地网页与 CLI",
    "美国上市股票和 ETF 的研究记录",
    "人工冻结小宇宙的日线、周/月节奏",
    "结构化 AI 候选导入，不内置自动交易代理",
    "本地 PaperAccount 与 provider-neutral 外部协议边界",
    "SQLite 单一事实源、Obsidian 导出、Git/GitHub 和私人备份"
  ],
  "non_goals": [
    "真实资金、live broker、实盘凭据或自动下单",
    "声称任何策略已经具有可交易优势",
    "高频、日内或依赖成交速度的策略",
    "动态全市场历史选股和已经完全解决生存者偏差",
    "多用户、商业化、云部署或合规认证",
    "用 Paper P&L 推断实盘可实现性"
  ],
  "authority": {
    "builder": "只能提交候选产物和候选完成状态",
    "contract_change": "冻结后只能新增 superseding contract；不得原位降低门槛",
    "acceptance": "机械检查、独立黑盒/故障检查、恢复演练、用户立场检察官和只读保障审查共同决定",
    "human_reserved": [
      "真实投资决定",
      "风险参数和残余风险接受",
      "未来真实资金或 live trading 的任何新授权"
    ]
  },
  "allowed_write_paths": [
    "src/",
    "tests/",
    "acceptance/",
    "scripts/",
    "fixtures/",
    "web/",
    "evidence/",
    "governance/",
    "research/",
    "audits/",
    "backups/",
    "项目根目录的文档、配置、CI 和打包文件"
  ],
  "protected_paths": [
    "prototype/",
    "governance/FROZEN_BUNDLE_V1.json",
    "evidence/reviews/independent_*",
    "项目外的私人文件",
    "Gmail、课程资料、私人通信和真实券商资料"
  ],
  "required_artifacts": [
    "pyproject.toml",
    "src/investment_discipline/",
    "web/",
    "tests/",
    "acceptance/",
    "scripts/verify_all.py",
