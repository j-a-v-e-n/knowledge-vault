  "future_role_constraints": {
    "acceptance_reviewer": {
      "must_be_assigned_after_candidate_tree_is_fixed": true,
      "must_not_equal": ["SUBJECT-BUILDER-MAIN"],
      "must_read": ["frozen bundle", "raw repository", "raw test results"],
      "must_add": ["independent tests or attacks", "candidate-bound findings", "open severity counts"],
      "must_record": ["subject id", "agent/session locator", "prompt/input hash", "candidate commit/tree", "frozen bundle hash", "raw result hashes", "participation history"]
    },
    "user_proxy": {
      "must_be_assigned_after_candidate_tree_is_fixed": true,
      "must_not_equal": ["SUBJECT-BUILDER-MAIN", "acceptance_reviewer"],
      "must_start_from": ["USER_SOURCE_EXCERPTS_V1.json", "USER_INTENT_V1.json", "ACCEPTANCE_CONTRACT_V1.json"],
      "must_not_start_from": ["builder completion summary"]
    },
    "independence_probe": {
      "required": true,
      "rule": "由非 builder 主体在候选固定后新增构造者事先未知的缺陷变异或攻击；探针必须造成相关 verification 失败，并保存原始输入、预期与结果。"
    }
  },
  "evidence_rule": "独立 evidence 文件必须 append-new、绑定当前候选且由发布谓词验证；builder 写路径权限这一事实必须保留在限制中，不能用文件名 independent 代替独立性。"
