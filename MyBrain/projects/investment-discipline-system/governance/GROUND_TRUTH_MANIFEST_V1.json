    },
    {
      "category": "mutable_project_state",
      "examples": [
        "LOOP_RUN_LOG.md",
        "ROADMAP.md",
        "STATUS.md",
        "TASK_BOARD.md"
      ],
      "reason": "这些文件表达当前进度或计划，会随工作推进变化，不作为设计语义的内容寻址根事实。"
    },
    {
      "category": "runtime_outputs_and_private_state",
      "examples": [
        "backups/",
        "evidence/",
        "prototype/data/runs/",
        "runtime SQLite databases"
      ],
      "reason": "运行结果、条件证据、备份和私人状态有独立候选绑定、保密、保留和恢复规则，不进入设计 ground-truth 清单。"
    },
    {
      "category": "self_reference",
      "examples": [
        "governance/GROUND_TRUTH_MANIFEST_V1.json"
      ],
      "reason": "自包含 SHA-256 会形成递归；清单本身由外层冻结包寻址。"
    }
  ],
