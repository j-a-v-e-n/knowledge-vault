{
  "schema_version": "work-packet-policy/v2",
  "policy_id": "ORG-01-ORG-03-WORK-PACKET-V2",
  "linked_failure_ids": [
    "ORG-01",
    "ORG-03"
  ],
  "packet_discovery": {
    "filename_suffix": ".packet.json",
    "recursive": false,
    "reject_unexpected_entries": true
  },
  "packet_schema": {
    "instance_schema_version": "work-packet-instance/v2",
    "historical_superseded_instance_schema_versions": [
      "work-packet-instance/v1"
    ],
    "required_fields": [
      "schema_version",
      "packet_id",
      "goal_id",
      "state",
      "owner",
      "reviewer",
      "bounded_write_paths",
      "read_dependencies",
      "acceptance_checks",
      "checkpoint_path",
      "acceptance_receipt_path",
      "retry_budget",
      "external_side_effects",
      "semantic_invariants",
      "depends_on",
      "activates",
      "integration_invariants",
      "routing"
    ],
    "state_values": [
      "pending",
      "active",
      "blocked",
      "candidate_complete",
      "complete",
      "superseded"
    ]
  },
  "path_rules": {
    "format": "normalized_posix_relative",
    "forbidden_glob_characters": [
      "*",
      "?",
      "[",
      "]",
      "{",
      "}"
    ],
    "minimum_tree_depth": 2,
    "maximum_write_claims_per_packet": 32,
    "maximum_read_dependencies_per_packet": 128,
    "read_dependencies_must_exist": true,
    "read_dependencies_must_be_files": true,
    "nested_write_symlinks_allowed": false
  },
  "ownership": {
    "ownership_states": [
      "active",
      "blocked",
      "candidate_complete"
    ],
    "conflict_relation": "canonical_equal_or_ancestor",
    "read_dependencies_confer_write_ownership": false,
    "completed_packets_retain_write_ownership": false
  },
  "completion": {
    "checkpoint_required_states": [
      "candidate_complete",
      "complete",
      "superseded"
    ],
    "acceptance_required_states": [
      "complete",
      "superseded"
    ],
    "receipt_directory": ".work_packets/receipts",
    "checkpoint_schema_version": "work-packet-checkpoint/v2",
    "acceptance_schema_version": "work-packet-acceptance/v2",
    "historical_checkpoint_schema_version": "work-packet-checkpoint/v1",
    "historical_acceptance_schema_version": "work-packet-acceptance/v1",
    "checkpoint_filename_suffix": ".checkpoint.json",
    "acceptance_filename_suffix": ".acceptance.json"
  },
  "supersession": {
    "state": "superseded",
    "successor_field": "superseded_by",
    "successor_allowed_states": [
      "active",
      "blocked",
      "candidate_complete",
      "complete"
    ],
    "successor_must_exist": true,
    "successor_must_share_goal": true,
    "successor_must_reclaim_exact_write_set": true,
    "historical_receipts_remain_required": true,
    "historical_snapshot_rule": "validate_receipt_schema_and_original_claim_identity_without_comparing_later_file_bytes"
  },
  "semantic_integration": {
    "probe_states": [
      "active",
      "blocked",
      "candidate_complete",
      "complete"
    ],
    "supported_probes": [
      "json_integer_sum_lte"
    ],
    "minimum_inputs_per_probe": 2
  },
  "dag": {
    "live_states": [
      "pending",
      "active",
      "blocked",
      "candidate_complete",
      "complete"
    ],
    "dependency_field": "depends_on",
    "activation_field": "activates",
    "require_exact_bidirectional_edges": true,
    "require_acyclic": true,
    "unique_root_per_goal": true,
    "unique_sink_per_goal": true,
    "require_root_to_sink_coverage": true
  },
  "activation": {
    "verified_complete_state": "complete",
    "unverified_prerequisite_allowed_state": "pending",
    "stale_pending_error": "stale_pending_activation",
    "blocked_propagation": "strict_descendants_only"
  },
  "parallel_conflicts": {
    "scope": "all_live_incomparable_packets",
    "path_relation": "canonical_equal_or_ancestor",
    "reject_write_write": true,
    "reject_read_write": true,
    "reject_identical_external_side_effects": true
  },
  "integration_probes": {
    "join_minimum_dependencies": 2,
    "minimum_inputs_per_invariant": 1,
    "multi_node_goal_minimum_probe_declarations": 1,
    "probe_receipt_required_states": [
      "candidate_complete",
      "complete"
    ],
    "input_packet_must_be_direct_dependency": true,
    "input_path_must_be_owned_by_input_packet": true,
    "input_path_must_be_join_read_dependency": true,
    "probe_check_must_belong_to_join": true
  },
  "checkpoint_prerequisites": {
    "field": "prerequisite_receipts",
    "binding": "exact_direct_dependency_contract_checkpoint_and_acceptance_sha256",
    "required_for_v2_checkpoints": true
  },
  "routing": {
    "required_fields": [
      "phase_id",
      "action_id",
      "route_order",
      "addresses_finding_ids",
      "summary"
    ],
    "phase_id_rule": "lowercase_identifier",
    "action_id_rule": "globally_unique_ACT_identifier",
    "route_order_rule": "globally_unique_positive_integer",
    "addresses_finding_ids_rule": "unique_identifiers_may_be_empty",
    "claim_boundary": "routing orders work and binds optional finding addresses; it does not prove that a route resolves a finding"
  },
  "platform_and_process_limitations": [
    "Path ownership is cooperative validation, not an operating-system access-control boundary; another process can still write after verification.",
    "Acceptance receipts bind declared checks to packet content and expose recorded process exit codes, but this verifier does not execute, authenticate, or sandbox those commands.",
    "Canonical-path, symlink, and content-snapshot checks are point-in-time local-filesystem observations and cannot eliminate time-of-check/time-of-use, mount, case-folding, or all hard-link alias races.",
    "There is no distributed lock or process isolation; the supplied packet directory must be an authoritative, consistent snapshot of all concurrent packets.",
    "Semantic integration is checked only for declared supported invariants and inputs; omitted or incorrectly modeled invariants remain outside this mechanism.",
    "A superseded packet preserves its original receipt binding and claim identities, but later file bytes are evidence of the successor packet and cannot re-prove the historical snapshot without repository history.",
    "DAG state, activation, and blocked propagation are validated from the supplied snapshot and do not schedule, lock, or mutate packet execution.",
    "Integration probe receipts prove only that the declared process exit records are internally bound and successful; they do not authenticate the process that produced them."
  ]
}
