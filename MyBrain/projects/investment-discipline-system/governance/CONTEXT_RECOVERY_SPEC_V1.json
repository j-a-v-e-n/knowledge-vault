  "claim_boundary": {
    "proof_scope": "A deterministic standard-library oracle reads the required state-packet file bytes, checks frozen ordered section markers, replays six bounded recovery probes, and compares the derived observations with an explicit frozen receipt.",
    "does_not_prove": [
      "real LLM recall",
      "unknown-position statistical coverage",
      "production incident rate",
      "model- or harness-independent behavior"
    ],
    "residual_limitation": "This design freeze proves only the specified byte checks and deterministic fixture behavior. Retrieval by a real model, arbitrary context lengths and positions, compaction implementations, and future harness revisions require separately pinned empirical runs."
  },
