{
  "schema_version": 1,
  "status": "candidate_for_freeze",
  "contract_id": "ids-local-paper-workbench-v1",
  "phase_rules": {
    "design_freeze": "研究 challenge 已关闭、stop rule 已满足；所有 requirement/control/verification/spec 双向无孤儿；规范文件已提交推送并由两阶段 frozen bundle 绑定。产品行为证据此时允许 not_run_preimplementation。",
    "product_release": "除明确 conditional gate 外，每个被 requirement 引用的 verification 都必须生成绑定当前 candidate 与 frozen bundle 的 pass 证据；顶层发布谓词逐项读取结果，不能信任聚合脚本退出码。",
    "personal_core_acceptance": "product_release 通过后，还需要 Javen 完成真实人工 onboarding 和至少一条端到端纸面旅程；长期采用和投资优势仍是条件性未证明。"
  },
  "result_schema": {
    "required": [
      "schema_version",
      "verification_id",
      "candidate_commit",
      "candidate_tree",
      "frozen_bundle_sha256",
      "run_id",
      "executor_id",
      "subject_id",
      "started_at",
      "completed_at",
      "status",
      "input_hashes",
      "raw_result_hashes",
      "oracle_id",
      "oracle_observations",
      "negative_cases",
      "finding_ids"
    ],
    "status_enum": ["pass", "fail", "blocked", "not_run_preimplementation", "not_applicable_by_frozen_scope"],
    "pass_rule": "status=pass，所有必需 negative case 实际执行且结果符合 oracle，input/raw result hash 可重算，候选与 frozen bundle 完全匹配，且没有 open critical/major finding。"
  },
  "executors": [
    {"id": "EX-GOVERNANCE", "command": "python3 scripts/verify_governance.py", "trust": "builder-authored deterministic; cannot alone approve"},
    {"id": "EX-RELEASE", "command": "python3 scripts/verify_release.py --evidence evidence/acceptance/latest.json", "trust": "builder-authored aggregator; recomputes links but cannot alone approve"},
    {"id": "EX-UNIT", "command": "PYTHONPATH=src python3 -m unittest discover -s tests -v", "trust": "development behavior"},
    {"id": "EX-ACCEPTANCE", "command": "PYTHONPATH=src python3 -m unittest discover -s acceptance -v", "trust": "black-box and adversarial behavior"},
    {"id": "EX-STATIC", "command": "python3 scripts/verify_static.py", "trust": "static evidence"},
    {"id": "EX-RESTORE", "command": "python3 scripts/restore_drill.py --mode local-release", "trust": "fresh-directory recovery"},
    {"id": "EX-BROWSER", "command": "controlled browser against a newly started local service", "trust": "tool-observed UI and HTTP behavior"},
    {"id": "EX-INDEPENDENT", "command": "independent reviewer reads raw fixed candidate and executes self-chosen attacks", "trust": "separate context with recorded provenance; bounded epistemic independence"},
    {"id": "EX-USER-PROXY", "command": "independent user-proxy starts from frozen source excerpts and raw evidence", "trust": "separate context; veto only"},
    {"id": "EX-HUMAN", "command": "Javen uses local onboarding/confirmation path without sharing confirmation material", "trust": "human-reserved; required only where explicitly stated"},
    {"id": "EX-CONDITIONAL", "command": "python3 scripts/verify_conditionals.py", "trust": "detects prerequisites and state transitions without reading secret values"}
  ],
  "input_profiles": [
    {"id": "IN-FROZEN", "required": ["frozen bundle", "baseline commit/tree", "all normative files", "origin reachability"]},
    {"id": "IN-CANDIDATE", "required": ["fixed candidate commit/tree", "frozen bundle", "clean fixture workspace", "run manifest"]},
    {"id": "IN-FAULT-FIXTURES", "required": ["fixed candidate", "golden fixtures", "negative fixtures", "fault plan", "fresh temporary state"]},
    {"id": "IN-LOCAL-SERVICE", "required": ["fixed candidate", "new temporary database", "loopback service", "browser/HTTP client"]},
    {"id": "IN-RECOVERY", "required": ["origin commit", "private fixture backup", "empty destination", "expected manifest"]},
    {"id": "IN-INDEPENDENT", "required": ["fixed candidate", "frozen intent/contract", "raw results", "no builder completion summary"]},
    {"id": "IN-HUMAN", "required": ["fixed candidate", "fresh install", "human-only confirmation material", "recorded journey id"]},
    {"id": "IN-CONDITIONAL", "required": ["fixed candidate", "frozen condition definitions", "prerequisite presence booleans", "condition evidence"]}
  ],
  "oracles": [
    {"id": "O-CANDIDATE-BINDING", "rule": "all hashes, subjects, times, evidence and findings refer to the exact frozen baseline and candidate; stale, missing or circular evidence fails"},
    {"id": "O-EXACT-INVARIANTS", "rule": "explicit database/domain invariants and expected values match exactly; absence of exception is insufficient"},
    {"id": "O-FAIL-CLOSED", "rule": "malformed, missing, stale, forged, conflicting, concurrent or faulted input is rejected or enters an explicit non-success recovery state"},
    {"id": "O-ROUNDTRIP", "rule": "replay/export/restore/restart produces exact canonical state and hashes from independent reconstruction"},
    {"id": "O-HUMAN-RESERVED", "rule": "high-impact action succeeds only through authenticated human capability; actor labels and ordinary automation cannot create it"},
    {"id": "O-SEMANTIC-BOUNDARY", "rule": "deterministic integrity and semantic support are separate; unsupported or contradictory critical claims remain unproved and block dependent approval"},
    {"id": "O-USER-JOURNEY", "rule": "real CLI/HTTP/browser journey reaches expected state, exposes failures and no-trade paths, and does not rely on hidden direct database edits"},
    {"id": "O-CONDITIONAL-STATE", "rule": "prerequisite observation, allowed transition, mandatory gate, evidence and aggregate verdict mapping agree exactly"}
  ],
  "negative_fixture_sets": [
